# ─── Copy to .env and fill in. Never commit .env. ─────────────────────────────
# Supabase → Project Settings → General / API (and Data API) / Database
SUPABASE_PROJECT_REF=abcdefghijklmnopqrst
SUPABASE_URL=https://abcdefghijklmnopqrst.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-or-secret-key
SUPABASE_DB_PASSWORD=the-database-password-you-chose

# Google AI Studio → Get API key
GEMINI_API_KEY=your-gemini-key
# Model names change every few months; check https://ai.google.dev/gemini-api/docs/models
GEMINI_CHAT_MODEL=gemini-flash-lite-latest
GEMINI_EMBED_MODEL=gemini-embedding-001

# Prices in USD per 1M tokens, from https://ai.google.dev/gemini-api/docs/pricing
# (used only to log the cost of each query in INR)
PRICE_IN_PER_M=
PRICE_OUT_PER_M=
PRICE_EMBED_PER_M=0.15
USD_INR=85

# Retrieval tuning (change, redeploy, rerun the eval, compare)
MATCH_COUNT=8
FULL_TEXT_WEIGHT=1
SEMANTIC_WEIGHT=1
CHUNK_MAX_TOKENS=500
CHUNK_OVERLAP_TOKENS=50

# Any long random string; the database trigger sends it to the ingest function
WEBHOOK_SECRET=change-me-to-a-long-random-string
# Password for the 4 demo users (admin@, buyer@, finance@, warehouse@prakriti.demo)
DEMO_PASSWORD=choose-a-demo-password

# Optional: Slack app → Basic Information (signing secret) and OAuth & Permissions (bot token)
SLACK_SIGNING_SECRET=
SLACK_BOT_TOKEN=
