{
  "name": "opspilot",
  "version": "1.0.0",
  "private": true,
  "description": "Procurement RAG copilot: Supabase pgvector + Gemini + Netlify + Slack",
  "type": "module",
  "scripts": {
    "test": "node --import tsx --test test/*.test.ts",
    "test:sql": "node --import tsx --test test/sql.test.ts",
    "test:po": "node --import tsx --test test/po-extractor.test.ts",
    "seed": "tsx scripts/seed.ts",
    "ingest": "tsx scripts/bulk-ingest.ts",
    "reingest": "tsx scripts/reingest.ts",
    "eval": "tsx scripts/run-eval.ts",
    "typecheck:functions": "deno check supabase/functions/*/index.ts"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.49.0",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.0",
    "@types/node": "^22.10.0",
    "fflate": "^0.8.3",
    "tsx": "^4.19.2",
    "typescript": "^5.7.0",
    "unpdf": "^1.0.0",
    "xlsx": "^0.18.5"
  }
